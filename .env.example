# Copy to .env and fill in. Secrets come from environment variables ONLY —
# a credential literal in source code fails CI. Per-entity credentials are
# prefixed with the entity's credentials_prefix (ITHRIVE_, LIMAZULU_, ...).
#
# BOTH halves of the system read this one file: `docker compose` reads it,
# and so does `shannon`, which looks in the current folder and each folder
# above it. Nothing needs exporting into your shell by hand — though a real
# environment variable does win over this file, so one value can be
# overridden for one command. Point somewhere else with AGENT_ORG_ENV_FILE.

# Phase 1 runs against saved exports (fixtures), so ONLY the four
# infrastructure values below are needed to run `shannon validate-config`
# and `shannon run`. Everything further down belongs to later phases;
# leave it blank until the phase that uses it is built.

# ---- Infrastructure (shared, unprefixed) ----
POSTGRES_PASSWORD=                 # you choose it; the database owner's password (docker-compose uses it)
POSTGRES_APP_PASSWORD=             # you choose it; `shannon migrate` gives it to the application role
DATABASE_URL=postgresql://agent_org_app:${POSTGRES_APP_PASSWORD}@127.0.0.1:5432/agent_org
DATABASE_MIGRATOR_URL=postgresql://agent_org_migrator:${POSTGRES_PASSWORD}@127.0.0.1:5432/agent_org
APPROVAL_TOKEN_SECRET=             # you generate: openssl rand -hex 32 — signs email/SMS approval links

# ---- LLM providers (shared; routed per task in config) ----
ANTHROPIC_API_KEY=                 # https://console.anthropic.com/settings/keys
OPENAI_API_KEY=                    # https://platform.openai.com/api-keys (optional second provider)

# ---- Notifications: SMS transport (shared) ----
TWILIO_ACCOUNT_SID=                # https://console.twilio.com — Account Info
TWILIO_AUTH_TOKEN=                 # same page
TWILIO_FROM_NUMBER=                # your Twilio phone number

# ---- iThrive Medical: sending identity ----
# Shannon sends from and to zach@ithrivemedical.com — the iThrive operating
# address — using that mailbox's own authenticated SMTP credentials. No new
# sending mailbox, DNS, or domain authentication needed. Recipient roles
# resolve to addresses/numbers in config/ithrive/shannon.yaml; NO address
# appears in code. (zach@shipsmooth.com is a vendor/tooling identity and
# receives no agent mail.)
ITHRIVE_SMTP_HOST=                 # the ithrivemedical.com mailbox provider's SMTP settings
ITHRIVE_SMTP_PORT=587
ITHRIVE_SMTP_USERNAME=             # zach@ithrivemedical.com
ITHRIVE_SMTP_PASSWORD=             # e.g. Google Workspace App Password: https://myaccount.google.com/apppasswords
ITHRIVE_ZACH_SMS_NUMBER=           # Zach's mobile, E.164 (+1...) — referenced from config/ithrive/shannon.yaml

# ---- iThrive Medical: Veeqo (INVENTORY TRUTH) ----
ITHRIVE_VEEQO_API_KEY=             # Veeqo web app: Settings -> Users -> API Keys

# ---- iThrive Medical: Shopify (BOM source ONLY — stock numbers are placeholders) ----
ITHRIVE_SHOPIFY_STORE_DOMAIN=      # e.g. ithrive-medical.myshopify.com
ITHRIVE_SHOPIFY_ADMIN_TOKEN=       # Shopify admin: Settings -> Apps and sales channels
                                   # -> Develop apps -> create app -> Admin API access token

# ---- iThrive Medical: QuickBooks Online (OAuth) ----
ITHRIVE_QBO_CLIENT_ID=             # https://developer.intuit.com -> your app -> Keys & credentials
ITHRIVE_QBO_CLIENT_SECRET=         # same page
ITHRIVE_QBO_REALM_ID=              # QBO company id, shown during the OAuth connect flow
ITHRIVE_QBO_REFRESH_TOKEN=         # produced by the one-time OAuth consent (docs/setup.md, future)

# ---- iThrive Medical: narescue.com (cart API — stage cart, never check out) ----
# EMAIL, not USERNAME: this file said USERNAME while the code has always read
# EMAIL, so a .env filled in from it left the cart client seeing nothing.
ITHRIVE_NAR_EMAIL=                 # the narescue.com account email (Chrome saved passwords
ITHRIVE_NAR_PASSWORD=              # are unreachable from the automation container)

# ---- iThrive Medical: dynarex.com (browser automation — stage cart, never check out) ----
ITHRIVE_DYNAREX_EMAIL=             # Zach's dynarex.com account email
ITHRIVE_DYNAREX_PASSWORD=          # its password

# ---- iThrive Medical: Gmail (authoritative on_order source — read-only) ----
# An NAR order is outstanding iff it has a confirmation email and no matching
# shipping notification. A Gmail read failure fails the run, like Veeqo.
ITHRIVE_GMAIL_CLIENT_ID=           # https://console.cloud.google.com -> APIs & Services ->
ITHRIVE_GMAIL_CLIENT_SECRET=       # Credentials -> OAuth client (Gmail API, gmail.readonly scope)
ITHRIVE_GMAIL_REFRESH_TOKEN=       # produced by the one-time OAuth consent

# ---- Amazon SP-API: DELIBERATELY ABSENT in v1 ----
# Amazon data comes via Veeqo initially. When SP-API is adopted, add
# ITHRIVE_SPAPI_* here. Walmart channels are modelled in config but have no
# credentials yet (zero sales history; nothing to pull).

# ---- Lima Zulu Group (later phases; listed so the prefix scheme is visible) ----
#LIMAZULU_QBO_CLIENT_ID=
#LIMAZULU_QBO_CLIENT_SECRET=
#LIMAZULU_QBO_REALM_ID=
#LIMAZULU_QBO_REFRESH_TOKEN=
# Voly has NO public API — export-driven, no credential; exports land in a
# watched folder when that phase is built.
